# Upstash Redis Configuration
# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# APNs (Apple Push Notification service) Configuration
# Without these the backend runs in mock mode: notifications are logged,
# never delivered. Create an APNs Auth Key (.p8) in the Apple Developer
# Portal under Certificates, Identifiers & Profiles > Keys.
APNS_KEY_ID=your-10-char-key-id
APNS_TEAM_ID=your-10-char-team-id
# Contents of the AuthKey_XXXXXXXXXX.p8 file (headers optional; literal \n ok)
APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 'production' for TestFlight and App Store builds (both use production APNs);
# 'development' only for Xcode debug builds.
APNS_ENVIRONMENT=production
# Must match the app's bundle ID or APNs rejects pushes with TopicDisallowed.
APNS_TOPIC=com.cloudview.app
